<!-- The following XML example represents a configuration where all IPv4
    ICMP echo requests are dropped. -->
<acls xmlns="urn:ietf:params:xml:ns:yang:ietf-access-control-list">
    <acl>
        <name>sample-icmp-acl</name>
        <type>ipv4-acl-type</type>
        <aces>
        <ace>
            <name>rule1</name>
            <matches>
            <ipv4>
                <protocol>1</protocol>
            </ipv4>
            <icmp>
                <type>8</type>
                <code>0</code>
            </icmp>
            </matches>
            <actions>
            <forwarding>drop</forwarding>
            </actions>
        </ace>
        </aces>
    </acl>
</acls>
