<acls xmlns="urn:ietf:params:xml:ns:yang:ietf-access-control-list">
    <acl>
        <name>sample-ipv6-acl</name>
        <type>ipv6-acl-type</type>
        <aces>
        <ace>
            <name>rule1</name>
            <matches>
            <ipv6>
                <dscp>1</dscp>
                <length>232</length>
                <flow-label>22</flow-label>
                <destination-ipv6-network>1234:1234:1234:1234::/64</destination-ipv6-network>
                <source-ipv6-network>1111:111::/64</source-ipv6-network>
            </ipv6>
            </matches>
            <actions>
            <forwarding>drop</forwarding>
            </actions>
        </ace>
        </aces>
    </acl>
</acls>
