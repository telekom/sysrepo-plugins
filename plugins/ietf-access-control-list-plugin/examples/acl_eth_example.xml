<acls xmlns="urn:ietf:params:xml:ns:yang:ietf-access-control-list"
xmlns:eth="urn:ietf:params:xml:ns:yang:ietf-ethertypes">
    <acl>
        <name>sample-eth-acl</name>
        <type>eth-acl-type</type>
        <aces>
            <ace>
                <name>rule1</name>
                <matches>
                    <eth>
                        <destination-mac-address>11:22:33:44:55:66</destination-mac-address>
                        <source-mac-address>00:0f:54:0c:11:04</source-mac-address>
                        <ethertype>vlan</ethertype>
                    </eth>
                </matches>
                <actions>
                    <forwarding>accept</forwarding>
                </actions>
            </ace>
        </aces>
    </acl>
</acls>
