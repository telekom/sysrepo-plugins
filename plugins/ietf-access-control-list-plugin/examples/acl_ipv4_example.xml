<!-- Deny tcp traffic from 192.0.2.0/24, destined to 198.51.100.0/24 -->
<acls xmlns="urn:ietf:params:xml:ns:yang:ietf-access-control-list">
    <acl>
        <name>sample-ipv4-acl</name>
        <type>ipv4-acl-type</type>
        <aces>
        <ace>
            <name>rule1</name>
            <matches>
            <ipv4>
                <dscp>1</dscp>
                <length>232</length>
                <ttl>232</ttl>
                <protocol>6</protocol>
                <ihl>15</ihl> <!-- header length -->
                <destination-ipv4-network>198.51.100.0/24</destination-ipv4-network>
                <source-ipv4-network>192.0.2.0/24</source-ipv4-network>
            </ipv4>
            </matches>
            <actions>
            <forwarding>drop</forwarding>
            </actions>
        </ace>
        </aces>
    </acl>
</acls>
